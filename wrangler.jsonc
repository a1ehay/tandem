{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tandem",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://tandem.aleksejgladkih4.workers.dev"
  }
}
