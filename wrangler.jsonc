{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tandem",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-11-01",
  "keep_vars": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://tandem.aleksejgladkih4.workers.dev",
    "AUTH_PUBLIC_ORIGIN": "https://tandem.aleksejgladkih4.workers.dev",
    "AUTH_FROM_EMAIL": "Tutdesk <noreply@tutdesk.space>",
    "LIVEKIT_URL": "wss://tandem-ort23xrl.livekit.cloud"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tandem-auth",
      "database_id": "d3dcbc38-1729-47a3-b9ae-1f8991c6a52b",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "HOMEWORK_FILES",
      "id": "8fec99f48ff6438b8f7ac23f1d421a5b"
    }
  ]
}
